#!/usr/bin/env bash
# commit-msg: enforce line length and block AI/agent attribution.
#   - Every line of the message (title AND body) must be <= 80 characters.
#   - No "Co-Authored-By: <AI>" or "Generated with …" trailers (CLAUDE.md rule 1).
set -euo pipefail

msg_file="$1"
max=80
fail=0
lineno=0

while IFS= read -r line || [ -n "$line" ]; do
  lineno=$((lineno + 1))
  # Ignore comment lines and everything in the verbose diff section git may append.
  case "$line" in
    \#*) continue ;;
  esac
  len=${#line}
  if [ "$len" -gt "$max" ]; then
    echo "✖ Line $lineno is $len chars (max $max):" >&2
    echo "    $line" >&2
    fail=1
  fi
done < "$msg_file"

# Block AI/agent attribution (repo rule: commits are authored by Ishan alone).
if grep -qiE 'co-authored-by:[[:space:]]*.*(claude|anthropic|openai|gpt|copilot|codex|cursor|gemini)' "$msg_file" \
   || grep -qiE 'generated with .*(claude|copilot|ai)' "$msg_file" \
   || grep -q '🤖' "$msg_file"; then
  echo "✖ Commit message contains AI/agent attribution — remove it (see CLAUDE.md rule 1)." >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "Commit message rejected. Fix the above and recommit." >&2
  exit 1
fi
